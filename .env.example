# ==============================================================================
# Doc Analyzer AI Agent - Пример конфигурации
# ==============================================================================
#
# ИСПОЛЬЗОВАНИЕ:
#   1. Скопируйте этот файл:
#      cp .env.example .env
#   2. Отредактируйте .env под своё окружение
#   3. Запустите:
#      make up
#
# БЕЗОПАСНОСТЬ:
#   - Файл .env НЕ должен коммититься в git (добавлен в .gitignore)
#   - .env.example коммитится как шаблон с безопасными примерами
#
# ==============================================================================

# ==============================================================================
# Конфигурация LLM
# ==============================================================================

# Провайдер LLM для AI-агента
# Например: ollama, openai
LLM_PROVIDER=ollama

# Название LLM-модели для AI-агента
# Например: llama3.2, gpt-4, deepseek-v4-flash
LLM_MODEL=llama3.2

# Базовый URL API провайдера LLM
# Для локальной Ollama (на хосте):  http://host.docker.internal:11434
# Для локальной Ollama (в Docker):  http://ollama:11434
# Для OpenAI:                       https://api.openai.com/v1
# Для DeepSeek:                     https://api.deepseek.com
# Для Gemini:                       https://generativelanguage.googleapis.com/v1beta
# Или URL вашего провайдера
LLM_BASE_URL=http://host.docker.internal:11434

# API-ключ провайдера LLM
# Для ollama оставляйте пустым (локальная модель без ключа)
# Для OpenAI: sk-...
# Для DeepSeek: sk-...
# Для Gemini: AI...
LLM_API_KEY=


# ==============================================================================
# Конфигурация RAG для embedding'ов (векторного представления текста)
# ==============================================================================
# Требуется, если включено использование RAG: RAG_USE_VECTOR_DB=true

# Использовать внешнюю векторную БД (true/false)
# RAG_USE_VECTOR_DB=true

# Использовать локальную векторную БД (true/false)
# RAG_USE_LOCAL_VECTOR_DB=false

# Провайдер embedding-модели
# Например: ollama, openai
RAG_EMBEDDING_PROVIDER=ollama

# Название embedding-модели
# Например: nomic-embed-text, mxbai-embed-large, text-embedding-3-small, text-embedding-3-large
RAG_EMBEDDING_MODEL=nomic-embed-text

# Базовый URL API провайдера embedding'ов
# Тот же, что и LLM_BASE_URL, если для embedding'ов используется тот же провайдер
RAG_BASE_URL=http://host.docker.internal:11434

# API-ключ embedding-провайдера
# Для ollama оставляйте пустым (локальная модель без ключа)
RAG_API_KEY=

# Хост ChromaDB
RAG_HOST=localhost

# Порт ChromaDB
RAG_PORT=8000

# Расположение локальной базы данных ChromaDB (для RAG_USE_LOCAL_VECTOR_DB=true)
RAG_PATH=./chromadb

# Имя коллекции в ChromaDB
RAG_COLLECTION=agent-rag


# ==============================================================================
# Конфигурация базы данных (PostgreSQL)
# ==============================================================================
# Требуется, если промпты берутся из базы данных: USE_DB_PROMPTS=true

# Брать промпты из базы данных
# USE_DB_PROMPTS=true

# Имя пользователя базы данных
DB_USER=agent

# Пароль пользователя базы данных
# ВАЖНО: используйте сильный пароль в production
DB_PASSWORD=changeme123

# Название базы данных
DB_NAME=agent_prompts

# Строка подключения к базе данных (составная переменная)
# PostgreSQL (Docker):
DB_URL="postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}"
# SQLite (локально без Docker):
# DB_URL=sqlite:///./data/prompts.db

# Включить логирование SQL-запросов (true/false)
# Полезно для отладки, но сильно увеличивает объем логов
DB_ECHO=false


# ==============================================================================
# OPTIONAL: Конфигурация pgAdmin
# ==============================================================================
# Раскомментируйте, если используете профиль admin
# Настройки веб-интерфейса pgAdmin для администрирования PostgreSQL
# pgAdmin доступен на http://localhost:5050

# Email для входа в pgAdmin
# ВАЖНО: используйте валидный email (не .local, см. ограничения email_validator)
# PGADMIN_EMAIL=admin@example.com

# Пароль для входа в pgAdmin
# Требования: минимум 8 символов, содержит цифру и заглавную букву
# PGADMIN_PASSWORD=Admin1234


# ==============================================================================
# OPTIONAL: Конфигурация observability (Grafana)
# ==============================================================================
# Раскомментируйте, если используете профиль observability
# Grafana доступна на http://localhost:3000

# Пароль администратора Grafana
# GRAFANA_PASSWORD=admin

# Публичный URL Grafana
# GRAFANA_ROOT_URL=http://localhost:3000


# ==============================================================================
# OPTIONAL: Конфигурация приложения
# ==============================================================================
# Дополнительные настройки приложения (обычно используются значения по умолчанию)

# Директория для загруженных документов внутри контейнера
# APP_DOCS_DIR=/app/documents

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Путь к файлу логов внутри контейнера
# LOG_PATH=/app/logs/backend.log

# Записывать логи в файл (true/false)
# LOG_WRITE_TO_FILE=true

# Хост для uvicorn внутри контейнера
# ВАЖНО: для Docker должно быть 0.0.0.0 (слушать все интерфейсы)
# SVC_HOST=0.0.0.0